---
import BaseLayout from "layouts/BaseLayout.astro";

import "styles/page.css";
---

<BaseLayout title="Home" description="Home of the Aphrodite Chibi library">
  <main style="align-items: center; text-align: center;">
    <img style="max-width: 320px;" alt="Chibi version of the virtual idol Hatsume Miku" fetchpriority="high" src="/images/miku.png" />
    <h1>Chibi</h1>
    <a href="/example-chip-group" data-astro-prefetch>Chip group tests</a>
    <a href="/example-checkbox" data-astro-prefetch>Checkbox tests</a>
    <a href="/example-input-field" data-astro-prefetch>Input field tests</a>
    <a href="/example-modal" data-astro-prefetch>Modal tests</a>
    <a href="/example-radio-group" data-astro-prefetch>Radio group tests</a>
    <a href="/example-select-group" data-astro-prefetch>Select group tests</a>
    <a href="/example-slider" data-astro-prefetch>Slider tests</a>
    <a href="/example-toggle-group" data-astro-prefetch>Toggle group tests</a>
    <a href="/example-tooltip" data-astro-prefetch>Tooltip tests</a>
    <a href="/mvp-business" data-astro-prefetch>MVP Business</a>
    <a href="/mvp-mortgage" data-astro-prefetch>MVP Mortgage</a>
    <hr/>
    <small>Done in 2026 by Eduardo.<br/>Chibi Hatsume Miku rights belong to Criterion</small>
  </main>
</BaseLayout>
