{
  "extends": "astro/tsconfigs/strict",
  "include": [".astro/types.d.ts", "src/**/*"],
  "exclude": ["node_modules", "dist", "public", ".astro"],
  "compilerOptions": {
    "strict": true,
    "baseUrl": "src",
    "jsx": "react-jsx",
    "jsxImportSource": "react",
    "incremental": true,
    "types": ["astro/client"],
  },
}
