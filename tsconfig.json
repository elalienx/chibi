{
  "extends": "astro/tsconfigs/strict",
  "include": [".astro/types.d.ts", "src/**/*", "playwright/**/*"],
  "exclude": ["node_modules", "dist", "public", ".astro"],
  "compilerOptions": {
    "strict": true,
    "paths": {
      "*": ["./src/*"]
    },
    "jsx": "react-jsx",
    "jsxImportSource": "react",
    "incremental": true,
    "types": ["astro/client"]
  }
}
