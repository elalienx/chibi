---
import BaseLayout from "layouts/BaseLayout.astro";

import "styles/base/page.css";
import "styles/base/home.css";
---

<BaseLayout title="Home" description="Home of the Chibi library">
  <main class="home" style="align-items: center; text-align: center;">
    <img style="max-width: 320px;" alt="Chibi version of the virtual idol Hatsune Miku" fetchpriority="high" src="/images/miku.png" />
    <h1>Chibi</h1>
    <div class="home-links">
      <nav aria-labelledby="components-title">
        <h2 id="components-title">Components</h2>
        <a href="/example-chip-group" data-astro-prefetch>Chip group</a>
        <a href="/example-checkbox" data-astro-prefetch>Checkbox</a>
        <a href="/example-input-field" data-astro-prefetch>Input field</a>
        <a href="/example-modal" data-astro-prefetch>Modal</a>
        <a href="/example-radio-group" data-astro-prefetch>Radio group</a>
        <a href="/example-select-group" data-astro-prefetch>Select group</a>
        <a href="/example-slider" data-astro-prefetch>Slider</a>
        <a href="/example-toggle-group" data-astro-prefetch>Toggle group</a>
        <a href="/example-tooltip" data-astro-prefetch>Tooltip</a>
      </nav>
      <nav aria-labelledby="nested-forms-title">
        <h2 id="nested-forms-title">Nested forms</h2>
        <a href="/example-sub-form-one-open" data-astro-prefetch>Sub-form one open</a>
        <a href="/example-sub-form-all-open" data-astro-prefetch>Sub-form all open</a>
      </nav>
      <nav aria-labelledby="mvp-title">
        <h2 id="mvp-title">MVP</h2>
        <a href="/mvp-business" data-astro-prefetch>MVP Business</a>
        <a href="/mvp-consumer" data-astro-prefetch>MVP Consumer</a>
        <a href="/mvp-mortgage" data-astro-prefetch>MVP Mortgage</a>
      </nav>
    </div>
    <hr/>
    <small>© 2026 Eduardo Alvarez<br/>Hatsune Miku © Crypton Future Media</small>
  </main>
</BaseLayout>
